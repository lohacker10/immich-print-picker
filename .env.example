# Immich server URL.
# Both https://immich.example.com and https://immich.example.com/api are accepted.
IMMICH_URL=https://immich.example.com

# Create an API key in Immich with:
# - album.read
# - activity.read
# - asset.download
IMMICH_API_KEY=replace-me

# Folder where exported ZIP archives are saved.
# With Docker Compose this is a path on the host.
# Without Docker, the Python script writes directly to this path.
DOWNLOAD_DIR=./downloads

# Keep this enabled when your Immich server uses a valid TLS certificate.
IMMICH_VERIFY_SSL=true
